# Copy to .env and fill in for local development.
#
# Everything below is PUBLIC. The publishable (anon) key is designed to be
# shipped in the browser bundle; it carries no privileges of its own. All
# access control is enforced by Postgres Row Level Security, so exposing this
# key is expected and safe.

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# VITE_-prefixed copies are what Vite inlines into the client bundle.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# NEVER put the service role key in this file or in .env.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security completely. Anything
# holding it can read and write every row in the database. Keep it out of every
# committed file; `.env` and `.env.local` are both gitignored.
#
# src/integrations/supabase/client.server.ts reads it from process.env at
# runtime. Set it as a server-side environment variable in your hosting
# platform, never in a committed file.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Desktop app (scripts/build-desktop.mjs, release builds only)
#
# The address of the web deployment that runs the server functions the desktop app calls
# (account creation, document storage...). Local builds (`--local`) use http://localhost:8080.
# The desktop window's Content Security Policy is generated from this value and the Supabase
# URL above, so a build can only talk to the backend it was built for.
# ---------------------------------------------------------------------------
DESKTOP_SERVER_ORIGIN="https://your-deployment.example.com"
