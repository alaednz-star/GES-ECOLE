# Environment variables of Gestion École. Copy what you need; never commit a filled-in copy.
#
#   .env.local   local development against the local Supabase stack (LOCAL_SETUP.md §3)
#   .env         release desktop builds against a school's deployed project (DEPLOYMENT.md §9)
#   Vercel       the web deployment's environment variables (DEPLOYMENT.md §5)
#
# The Supabase URL and publishable key are PUBLIC: they ship in the browser bundle and the
# desktop app, and Row Level Security protects the data.

# Read by the browser bundle and the desktop app (Vite inlines VITE_* at build time).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Read by the server at runtime (web deployment, local dev server).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY (secret key, `sb_secret_...` or legacy service_role JWT)
#
# Bypasses Row Level Security completely. Server-side only: a sensitive environment variable of
# the web deployment, or `.env.local` with the LOCAL stack's key for development. Never in `.env`
# used for desktop builds (the build strips it and refuses a bundle containing secret material),
# never in a committed file. Read by src/integrations/supabase/client.server.ts.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Desktop app (scripts/build-desktop.mjs, release builds only)
#
# The address of the web deployment that runs the server functions the desktop app calls
# (account creation, document storage...). Local builds (`--local`) use http://localhost:8080.
# The desktop window's Content Security Policy is generated from this value and the Supabase
# URL above, so a build can only talk to the backend it was built for.
# ---------------------------------------------------------------------------
DESKTOP_SERVER_ORIGIN="https://your-deployment.example.com"
